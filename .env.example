# ---------------------------------------------------------------------------
# Fragrance AI — environment variables (example / placeholders only)
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (used from Phase 2 onwards) ----------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fragrance_ai?schema=public"

# Optional per-instance pg connection-pool cap (serverless hosts: Netlify
# functions / Vercel functions each open up to this many Supabase pooler
# connections; the driver default of 10 can exhaust the Session Pooler).
# Defaults to 5 when unset.
PG_POOL_MAX=""

# --- AI provider (used from Phase 4 onwards) --------------------------------
# Provider is selected through this variable so the app never depends on a
# concrete vendor. Supported value in Phase 4: "qwen".
AI_PROVIDER="qwen"

# Qwen 3.6 via the GapGPT API (OpenAI-compatible /chat/completions).
# Server-side only — never exposed to the browser.
QWEN_API_KEY=""
QWEN_BASE_URL="https://api.gapgpt.app/v1"
QWEN_MODEL="gapgpt-qwen-3.6"

# Optional hard timeout (ms) for AI calls; the app must keep working without AI.
QWEN_TIMEOUT_MS="15000"
# --- AI cost controls (Phase 12.6-B; server-side only) ------------------------
# Process-local fixed-window request quotas and circuit breaker controls.
AI_GLOBAL_REQUEST_LIMIT_PER_WINDOW="1000"
AI_STORE_REQUEST_LIMIT_PER_WINDOW="200"
AI_USAGE_WINDOW_MS="60000"
AI_CIRCUIT_FAILURE_THRESHOLD="5"
AI_CIRCUIT_COOLDOWN_MS="60000"



# Public URL of THIS deployment, used to generate the merchant widget install
# snippet (Admin → کد نصب ویجت). Never invent a production host: set it to the
# real domain at deploy time. Locally it can stay unset — the admin page then
# falls back to the current request origin (http://localhost:3000).
NEXT_PUBLIC_APP_URL=""

# --- Admin access gate (pre-deployment hardening) ---------------------------
# Shared secret protecting every /admin/* route. Server-side only — never sent
# to the browser (the unlock cookie carries a SHA-256 hash, never this value),
# never stored in the database. FAIL-CLOSED: if unset, /admin/* is unreachable
# (the gate page explains the configuration problem). Set a long random value
# in production; rotating it instantly invalidates issued unlock cookies.
ADMIN_ACCESS_SECRET=""
